# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_PATH=./data/security-api.db

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-with-at-least-32-chars
JWT_EXPIRES_IN=15m

# Initial admin, created only when the users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please-123

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5

# Only set to true behind a reverse proxy you control (uses X-Forwarded-For)
TRUST_PROXY=false
# Comma-separated list of allowed origins; empty disables CORS
CORS_ORIGIN=
SEED_DEMO_DATA=true
